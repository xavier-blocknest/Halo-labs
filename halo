#!/bin/bash
# Halo Labs helper. Run from this folder:  ./halo <command>
# Works with the bash that ships with macOS (3.2) and with Linux.
set -euo pipefail
cd "$(dirname "$0")"

URL_DEFAULT="http://localhost:8787"
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
say() { printf '%s\n' "$*"; }
die() { printf 'halo: %s\n' "$*" >&2; exit 1; }

need_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker isn't installed. Install Docker Desktop (or OrbStack) first: see README.md."
  docker info >/dev/null 2>&1 || die "Docker isn't running. Open Docker Desktop (or OrbStack), wait for it to start, then try again."
}

env_get() { [ -f .env ] && grep -E "^$1=" .env | tail -1 | cut -d= -f2- || true; }

# Set KEY=VALUE in .env without touching any other line (the database key lives in this file).
env_set() {
  local key="$1" value="$2"
  touch .env && chmod 600 .env
  if grep -qE "^$key=" .env; then
    local tmp; tmp=$(mktemp)
    awk -v k="$key" -v v="$value" 'BEGIN{FS=OFS="="} $1==k{print k"="v; next} {print}' .env > "$tmp" && cat "$tmp" > .env && rm -f "$tmp"
  else
    [ -s .env ] && [ "$(tail -c1 .env)" != "" ] && printf '\n' >> .env
    printf '%s=%s\n' "$key" "$value" >> .env
  fi
}

mac_tz() {
  local tz=""
  if [ -L /etc/localtime ]; then tz=$(readlink /etc/localtime | sed -E 's#.*/zoneinfo/##'); fi
  [ -n "$tz" ] || tz=$(cat /etc/timezone 2>/dev/null || true)
  printf '%s' "${tz:-UTC}"
}

url() { local u; u=$(env_get PUBLIC_URL); printf '%s' "${u:-$URL_DEFAULT}"; }

wait_up() {
  say "Waiting for Halo Labs to start…"
  for _ in $(seq 1 90); do
    if curl -fsS "$URL_DEFAULT/api/health" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  die "Halo Labs didn't start in 3 minutes. See what went wrong with: ./halo logs"
}

setup_code() {
  if [ -f data/setup-code ]; then
    bold "Setup code: $(cat data/setup-code)"
    say "Enter it on the lock screen to create your passkey (Touch ID / iCloud Keychain). It works once."
  else
    say "No setup code: a passkey already exists. Lost them all? Run ./halo reset-passkeys"
  fi
}

cmd_setup() {
  need_docker
  if [ ! -f .env ] || [ -z "$(env_get HALO_TZ)" ]; then env_set HALO_TZ "$(mac_tz)"; fi
  [ -n "$(env_get PUBLIC_URL)" ] || env_set PUBLIC_URL "$URL_DEFAULT"
  bold "Building and starting Halo Labs (the first time takes a few minutes)…"
  docker compose up -d --build
  wait_up
  echo
  bold "Halo Labs is running at $(url)"
  setup_code
  echo
  say "Next: open the address above, create your passkey, then go to Settings → APIs to add your keys,"
  say "and download the recovery kit (Settings → Recovery kit) into your password manager."
  if command -v open >/dev/null 2>&1; then open "$(url)"; fi
}

cmd_phone() {
  # Phone access: Tailscale serves the app over HTTPS on this Mac's tailnet name. Passkeys are tied to the address,
  # so switching from localhost needs new passkeys.
  local ts=""
  for c in tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale; do command -v "$c" >/dev/null 2>&1 && { ts="$c"; break; }; done
  [ -n "$ts" ] || die "Tailscale isn't installed. Install it from tailscale.com/download (Mac and iPhone, same account), then run ./halo phone again."
  "$ts" serve --bg 8787 >/dev/null
  local name; name=$("$ts" serve status 2>/dev/null | grep -oE 'https://[A-Za-z0-9.-]+\.ts\.net' | head -1 || true)
  [ -n "$name" ] || die "Couldn't read the Tailscale HTTPS address. Turn on HTTPS certificates in the Tailscale admin console (DNS → HTTPS Certificates) and try again."
  if [ "$(url)" = "$name" ]; then say "Already set up: $name"; return; fi
  say "Halo Labs will move to $name (on this Mac too)."
  say "Passkeys made for $(url) won't work there, so they'll be removed and you'll get a new setup code."
  printf 'Continue? [y/N] '; read -r yn; case "$yn" in y|Y|yes) ;; *) say "Nothing changed."; return ;; esac
  env_set PUBLIC_URL "$name"
  docker compose exec -T halolabs node server/auth-reset.ts
  docker compose restart halolabs >/dev/null
  wait_up
  bold "Open $name on the Mac and on the iPhone (Tailscale on)."
  setup_code
  say "Also update the WHOOP and Strava redirect URLs to the new address (Settings → Sources shows them) and reconnect."
}

case "${1:-help}" in
  setup) cmd_setup ;;
  start) need_docker; docker compose up -d; wait_up; say "Running at $(url)" ;;
  stop) need_docker; docker compose stop ;;
  restart) need_docker; docker compose restart; wait_up; say "Running at $(url)" ;;
  rebuild) need_docker; docker compose up -d --build; wait_up; say "Running at $(url)" ;;
  status) need_docker; docker compose ps; curl -fsS "$URL_DEFAULT/api/health" >/dev/null 2>&1 && say "Healthy: $(url)" || say "Not answering at $URL_DEFAULT" ;;
  logs) need_docker; docker compose logs --tail "${2:-100}" -f halolabs ;;
  open) open "$(url)" 2>/dev/null || say "$(url)" ;;
  setup-code) setup_code ;;
  reset-passkeys)
    need_docker
    printf 'Remove every passkey and sign out everywhere? [y/N] '; read -r yn
    case "$yn" in y|Y|yes) docker compose exec -T halolabs node server/auth-reset.ts && docker compose restart halolabs >/dev/null && wait_up && setup_code ;; *) say "Nothing changed." ;; esac ;;
  phone) need_docker; cmd_phone ;;
  shell) need_docker; docker compose exec halolabs sh ;;
  check) need_docker; docker compose exec -T halolabs sh -c 'npx tsc -b && npx tsc -p tsconfig.server.json && npx vite build --logLevel warn' && say "Typecheck and build OK" ;;
  help|*)
    cat <<'EOF'
Halo Labs: ./halo <command>
  setup           first-time setup: settings file, build, start, open the app, print the setup code
  start | stop | restart
  status          is it running and answering?
  logs [n]        follow the server log (Ctrl-C to stop)
  open            open the app in the browser
  setup-code      print the one-time code for the first passkey
  reset-passkeys  remove all passkeys (when every device is lost), then print a new setup code
  phone           use Halo Labs from an iPhone through Tailscale (HTTPS address; needs new passkeys)
  check           typecheck and build inside the container (after code changes)
  rebuild         rebuild the Docker image (after changing the Dockerfile)
  shell           a shell inside the container
EOF
    ;;
esac
